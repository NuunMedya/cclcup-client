# CCL CUP — Apache ayarları
# Not: "Options" / "DirectoryIndex" satırları bilerek yok; birçok paylaşımlı
# hostingde .htaccess içinde izin verilmediği için 500 hatasına yol açıyorlar.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # inc/, cache/ ve config dosyalarına doğrudan erişimi engelle
  RewriteRule ^(inc|cache)(/|$) - [F,L]
  RewriteRule ^config\.php$ - [F,L]
  RewriteRule ^(README\.md|\.git) - [F,L]

  # Kısa adresler: /kurallar (sondaki / kaldırılır)
  RewriteRule ^kurallar/$ /kurallar [R=301,L]
  RewriteRule ^kurallar$ kurallar.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|svg|png|jpg|webp|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

ErrorDocument 404 /404.php
